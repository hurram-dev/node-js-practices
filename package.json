{
  "type": "module",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.3",
    "jest": "^30.2.0",
    "nodemon": "^3.1.14",
    "pm2": "^6.0.14",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsc-esm-fix": "^3.1.2",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "test": "jest",
    "build": "./node_modules/.bin/tsc --project tsconfig.json && ./node_modules/.bin/tsc-esm-fix",
    "start": "npm run build && ./node_modules/.bin/pm2 start ./dist/practical-task-4/server.js --name server",
    "stop": "./node_modules/.bin/pm2 stop server",
    "build:watch": "./node_modules/.bin/tsc --project tsconfig.json && ./node_modules/.bin/tsc-esm-fix --watch && node ./dist/practical-task-4/server.js",
    "dev": "./node_modules/.bin/nodemon --watch ./src --exec npm run build:watch"
  },
  "dependencies": {
    "csvtojson": "^2.0.14",
    "express": "^5.2.1",
    "zod": "^4.3.6"
  }
}
